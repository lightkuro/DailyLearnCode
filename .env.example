# Copy to .env.local for local development. On Cloudflare (or any host), set these as build variables.
# All are optional; leave a line empty to turn its feature off.

# Your site's address, e.g. https://code.example.com. Added to the share text, and only this host counts as
# production (any other host is treated as a preview build).
VITE_SITE_URL=
# Links to your own privacy policy and terms. The footer and About page show them only when set.
VITE_PRIVACY_URL=
VITE_TERMS_URL=
# Google OAuth client ID for the optional "sync to Google Drive" feature (public, not a secret). See the README.
VITE_GOOGLE_CLIENT_ID=
# 1 = phones sign in to Google in the same tab (needs <origin>/oauth as an authorised redirect URI).
VITE_GOOGLE_REDIRECT=
