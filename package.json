{
  "name": "dailylearncode",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A daily coding-interview practice game: a warm-up quiz, easy/medium/hard coding problems in Python, Java or C++, and an SWE quiz. Code runs in the browser.",
  "scripts": {
    "dev": "npm run content:build && vite",
    "build": "npm run content:build && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "content:build": "tsx scripts/build-content.ts",
    "content:finalize": "tsx scripts/finalize.ts",
    "content:validate": "tsx scripts/validate-content.ts",
    "learn:validate": "tsx scripts/validate-learn.ts",
    "serve:dist": "tsx tests/e2e/serve.ts 4173",
    "e2e": "tsx tests/e2e/smoke.ts",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@uiw/react-codemirror": "^4.25.12",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "1.60.0",
    "motion": "^14.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.1",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wrangler": "4.151.2"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lightkuro/dailylearncode.git"
  }
}
